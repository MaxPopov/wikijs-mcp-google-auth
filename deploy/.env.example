# Copy to .env next to docker-compose.prod.yml and fill in.

# Tagged release image of the MCP server (built by the release workflow
# from a vX.Y.Z tag on main, or built locally:
#   docker build -f packages/mcp-server/Dockerfile -t wikijs-mcp-server:v0.1.0 .
MCP_IMAGE=ghcr.io/OWNER/wikijs-mcp-server:v0.1.0

# Public HTTPS URL of this MCP server (behind your reverse proxy).
PUBLIC_URL=https://mcp.company.com

# Base URL of the EXISTING Wiki.js instance (reachable from this host).
WIKIJS_URL=https://wiki.company.com

# Instance key of the MCP Delegation strategy in Wiki.js admin.
WIKIJS_STRATEGY_KEY=mcpdelegation

# Google OAuth client (Web application) from Google Cloud Console.
# Authorized redirect URI must be: ${PUBLIC_URL}/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Workspace domain allowed to sign in (hd claim check).
GOOGLE_ALLOWED_DOMAIN=company.com

LOG_LEVEL=info
